@page "/"
@inject AppDbContext Db

<PageTitle>Dashboard</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Dashboard</MudText>

<MudPaper Class="pa-4" Elevation="1">
    <MudText Typo="Typo.h6" GutterBottom="true">Contacts by status</MudText>
    @if (_byStatus is null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        <MudSimpleTable Dense="true">
            <tbody>
                @foreach (var status in Enum.GetValues<ContactStatus>())
                {
                    <tr><td>@status</td><td>@(_byStatus.GetValueOrDefault(status).ToString("N0"))</td></tr>
                }
            </tbody>
        </MudSimpleTable>
    }
</MudPaper>

@code {
    private Dictionary<ContactStatus, int>? _byStatus;

    protected override async Task OnInitializedAsync() =>
        _byStatus = await Db.Contacts.GroupBy(c => c.Status)
            .Select(g => new { g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.Key, x => x.Count);
}
