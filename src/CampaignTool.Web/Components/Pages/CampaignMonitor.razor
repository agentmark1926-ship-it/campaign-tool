@page "/campaigns/{Id:int}"
@using CampaignTool.Web.Services
@implements IDisposable
@inject AppDbContext Db
@inject CampaignService CampaignService
@inject CampaignProgressNotifier Progress
@inject SettingsService SettingsService
@inject IDialogService Dialogs
@inject NavigationManager Nav

<PageTitle>@(_c?.Name ?? "Campaign")</PageTitle>

@if (_c is null)
{
    <MudText>@(_loaded ? "This campaign no longer exists." : "")</MudText>
    return;
}

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-3">
    <MudText Typo="Typo.h4">@_c.Name</MudText>
    <CampaignStatusChip Status="_c.Status" />
    <MudSpacer />
    <MudButton Href="/campaigns" Variant="Variant.Text">All campaigns</MudButton>
    @if (_c.Status == CampaignStatus.Sending) { <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="PauseAsync">Pause</MudButton> }
    @if (_c.Status == CampaignStatus.Paused) { <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ResumeAsync">Resume</MudButton> }
    @if (_c.Status is CampaignStatus.Sending or CampaignStatus.Paused) { <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="CancelAsync">Cancel</MudButton> }
    @if (_c.Status == CampaignStatus.Scheduled) { <MudButton Variant="Variant.Outlined" OnClick="UnscheduleAsync">Unschedule and edit</MudButton> }
</MudStack>

<MudText Class="mb-3">Subject: <b>@_c.Subject</b>@(_c.ScheduledAtUtc is { } at && _c.Status == CampaignStatus.Scheduled ? $" · scheduled for {TimeFormat.Local(at, _tz)} ({_tz})" : "")</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudProgressLinear Color="Color.Primary" Value="@Percent" Size="Size.Large" Rounded="true" />
    <MudText Typo="Typo.caption">@Done.ToString("N0") of @_c.Recipients.ToString("N0") processed (@Percent.ToString("0")%)</MudText>
    <MudGrid Class="mt-2">
        @foreach (var (label, value) in Counters)
        {
            <MudItem xs="6" sm="3">
                <MudText Typo="Typo.caption">@label</MudText>
                <MudText Typo="Typo.h5">@value.ToString("N0")</MudText>
            </MudItem>
        }
    </MudGrid>
</MudPaper>

@if (_unknown.Count > 0)
{
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.h6">Unknown (@_unknown.Count)</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">The app restarted while these were being sent; they may or may not have gone out. They are never resent automatically. Retry only if you're sure a duplicate is acceptable.</MudText>
        <MudSimpleTable Dense="true">
            <tbody>
                @foreach (var r in _unknown)
                {
                    <tr><td>@r.EmailSnapshot</td><td><MudButton Size="Size.Small" OnClick="@(() => RetryAsync(r.Id))">Retry</MudButton></td></tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudPaper>
}

<MudPaper Class="pa-4" Elevation="1">
    <MudText Typo="Typo.h6" GutterBottom="true">Latest events</MudText>
    <MudSimpleTable Dense="true">
        <thead><tr><th>Time (@_tz)</th><th>Recipient</th><th>Event</th><th>Detail</th></tr></thead>
        <tbody>
            @foreach (var e in _events)
            {
                <tr><td>@TimeFormat.Local(e.At, _tz, "MMM d, h:mm:ss tt")</td><td>@e.Email</td><td>@e.Kind</td><td>@e.Detail</td></tr>
            }
            @if (_events.Count == 0) { <tr><td colspan="4">No events yet.</td></tr> }
        </tbody>
    </MudSimpleTable>
</MudPaper>

@code {
    [Parameter] public int Id { get; set; }

    private record EventRow(DateTime At, string Email, string Kind, string Detail);

    private Campaign? _c;
    private bool _loaded;
    private string _tz = "UTC";
    private List<CampaignRecipient> _unknown = [];
    private List<EventRow> _events = [];
    private readonly SemaphoreSlim _gate = new(1, 1);

    private int Done => _c is null ? 0 : _c.Sent + _c.Failed + _cancelled;
    private int _cancelled;
    private double Percent => _c is null || _c.Recipients == 0 ? 0 : Math.Min(100, 100.0 * Done / _c.Recipients);

    private IEnumerable<(string, int)> Counters =>
    [
        ("Recipients", _c!.Recipients), ("Sent", _c.Sent), ("Delivered", _c.Delivered), ("Bounced", _c.Bounced),
        ("Failed", _c.Failed), ("Clicked", _c.Clicked), ("Unsubscribed", _c.Unsubscribed),
    ];

    protected override async Task OnInitializedAsync()
    {
        _tz = (await SettingsService.GetAsync()).TimeZone;
        Progress.Changed += OnProgress;
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
        if (_c?.Status == CampaignStatus.Draft) Nav.NavigateTo($"/campaigns/{Id}/edit", replace: true);
    }

    private void OnProgress(int campaignId)
    {
        if (campaignId != Id) return;
        _ = InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
    }

    private async Task LoadAsync()
    {
        if (!await _gate.WaitAsync(0)) return; // a reload is already running; it will pick up the latest counters
        try
        {
            _c = await Db.Campaigns.AsNoTracking().SingleOrDefaultAsync(c => c.Id == Id);
            _loaded = true;
            if (_c is null) return;
            _cancelled = await Db.CampaignRecipients.CountAsync(r => r.CampaignId == Id && r.Status == RecipientStatus.Cancelled);
            _unknown = await Db.CampaignRecipients.AsNoTracking().Where(r => r.CampaignId == Id && r.Status == RecipientStatus.Unknown).Take(200).ToListAsync();
            var sent = await Db.CampaignRecipients.AsNoTracking().Where(r => r.CampaignId == Id && r.SentAtUtc != null)
                .OrderByDescending(r => r.SentAtUtc).Take(50).Select(r => new EventRow(r.SentAtUtc!.Value, r.EmailSnapshot, "Sent", "")).ToListAsync();
            var reported = await Db.EmailEvents.AsNoTracking().Where(e => e.CampaignRecipient!.CampaignId == Id)
                .OrderByDescending(e => e.Id).Take(50).Select(e => new EventRow(e.OccurredAtUtc, e.CampaignRecipient!.EmailSnapshot, e.Kind.ToString(), e.Status + (e.Url != null ? " " + e.Url : ""))).ToListAsync();
            _events = sent.Concat(reported).OrderByDescending(e => e.At).Take(50).ToList();
        }
        finally { _gate.Release(); }
    }

    private async Task PauseAsync() { await CampaignService.PauseAsync(Id); await LoadAsync(); }
    private async Task ResumeAsync() { await CampaignService.ResumeAsync(Id); await LoadAsync(); }

    private async Task CancelAsync()
    {
        if (await Dialogs.ShowMessageBoxAsync("Cancel campaign", "Stop sending? Everyone not yet sent to is cancelled; this can't be resumed.", "Cancel campaign", cancelText: "Keep sending") != true) return;
        await CampaignService.CancelAsync(Id);
        await LoadAsync();
    }

    private async Task UnscheduleAsync()
    {
        await CampaignService.UnscheduleAsync(Id);
        Nav.NavigateTo($"/campaigns/{Id}/edit");
    }

    private async Task RetryAsync(long recipientId)
    {
        await CampaignService.RetryUnknownAsync(recipientId);
        await LoadAsync();
    }

    public void Dispose() => Progress.Changed -= OnProgress;
}
