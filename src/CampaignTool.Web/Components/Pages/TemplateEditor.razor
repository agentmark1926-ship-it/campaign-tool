@page "/templates/{Id:int}"
@using CampaignTool.Web.Services
@inject AppDbContext Db
@inject TemplateService TemplateService
@inject TestEmailService TestEmail
@inject ISnackbar Snackbar

<PageTitle>@(_template?.Name ?? "Template")</PageTitle>

@if (_template is null)
{
    <MudText>@(_loaded ? "This template no longer exists." : "")</MudText>
    return;
}

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-3">
    <MudTextField T="string" Value="_name" ValueChanged="NameChanged" Label="Template name" Variant="Variant.Outlined" Style="max-width:360px" />
    <MudSpacer />
    <MudButton Href="/templates" Variant="Variant.Text">Back</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_busy">Save</MudButton>
</MudStack>

<EmailBodyEditor @bind-Format="_format" @bind-Body="_body" Subject="@_testSubject" />

<MudPaper Class="pa-4 mt-4" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-2">Send a test</MudText>
    <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
        <MudTextField T="string" Value="_testSubject" ValueChanged="SubjectChanged" Label="Subject" Variant="Variant.Outlined" HelperText="Merge fields work here too." />
        <MudTextField @bind-Value="_testAddresses" Label="To (up to 5, comma-separated)" Variant="Variant.Outlined" />
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="SendTestAsync" Disabled="_busy">Send test</MudButton>
    </MudStack>
    @if (_outcomes is not null)
    {
        <MudSimpleTable Dense="true" Class="mt-2">
            <thead><tr><th>Address</th><th>Result</th></tr></thead>
            <tbody>
                @foreach (var o in _outcomes)
                {
                    <tr><td>@o.Address</td><td>@(o.Result.Success ? "Accepted" : o.Result.Error)</td></tr>
                }
            </tbody>
        </MudSimpleTable>
    }
</MudPaper>

@code {
    [Parameter] public int Id { get; set; }

    private Template? _template;
    private bool _loaded, _busy, _subjectEdited;
    private TemplateFormat _format;
    private string _name = "", _body = "", _testSubject = "", _testAddresses = "";
    private IReadOnlyList<TestEmailService.Outcome>? _outcomes;

    protected override async Task OnParametersSetAsync()
    {
        _template = await Db.Templates.AsNoTracking().SingleOrDefaultAsync(t => t.Id == Id);
        _loaded = true;
        if (_template is null) return;
        _name = _template.Name;
        _format = _template.Format;
        _body = _template.Body;
        _testSubject = DefaultSubject(_name);
    }

    private static string DefaultSubject(string name) => $"Hi {{{{ first_name | default: \"there\" }}}}: {name}";

    // The test subject follows the template name until the owner edits it.
    private void NameChanged(string v)
    {
        _name = v ?? "";
        if (!_subjectEdited) _testSubject = DefaultSubject(_name);
    }

    private void SubjectChanged(string v) { _testSubject = v ?? ""; _subjectEdited = true; }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            if (await TemplateService.SaveAsync(Id, _name, _format, _body) is { } error) { Snackbar.Add(error, Severity.Warning); return; }
            Snackbar.Add("Template saved.", Severity.Success);
        }
        finally { _busy = false; }
    }

    private async Task SendTestAsync()
    {
        _busy = true;
        _outcomes = null;
        try { _outcomes = await TestEmail.SendAsync(_testAddresses, _testSubject, _body, _format); }
        catch (ArgumentException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }
}
