@inherits LayoutComponentBase

<MudThemeProvider Theme="Midnight.Theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Class="d-flex d-md-none mid-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" aria-label="Menu" OnClick="() => _drawerOpen = !_drawerOpen" />
        <span class="mid-brand-name">SSD Campaigns</span>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md" Elevation="0" Width="232px" Class="mid-drawer">
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="mid-main">
        <div class="mid-content">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
}
