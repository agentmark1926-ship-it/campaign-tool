@* Unlayer editor wrapper, shared by the template editor and the campaign editor. *@
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-2">@_error</MudAlert>
}
@if (!_ready && _error is null)
{
    <MudProgressLinear Indeterminate="true" Class="mb-2" />
}
<div id="@_id" style="height:@(Height)px;border:1px solid #e0e0e0"></div>

@code {
    [Parameter] public string? DesignJson { get; set; }
    [Parameter] public int Height { get; set; } = 720;

    private readonly string _id = "editor-" + Guid.NewGuid().ToString("N");
    private IJSObjectReference? _module;
    private bool _ready;
    private string? _error;

    public bool Ready => _ready;

    private static readonly object MergeTags = new
    {
        first_name = new { name = "First name", value = "{{ first_name | default: \"there\" }}", sample = "Ann" },
        last_name = new { name = "Last name", value = "{{ last_name }}", sample = "Lee" },
        email = new { name = "Email", value = "{{ email }}", sample = "ann.lee@example.com" },
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/editor.js");
            await _module.InvokeVoidAsync("init", _id, string.IsNullOrWhiteSpace(DesignJson) ? null : DesignJson, MergeTags);
            _ready = true;
        }
        catch (JSException ex)
        {
            _error = $"The email editor didn't load ({ex.Message.Split('\n')[0]}). Check the internet connection and reload the page.";
        }
        StateHasChanged();
    }

    public record Export(string Design, string Html);

    /// <summary>The current design and its exported HTML.</summary>
    public async Task<Export?> ExportAsync()
    {
        if (_module is null || !_ready) return null;
        try { return await _module.InvokeAsync<Export>("exportHtml"); }
        catch (Exception ex) when (ex is ObjectDisposedException or JSDisconnectedException) { return null; } // page is closing
    }

    public async ValueTask DisposeAsync()
    {
        var module = _module;
        _module = null;
        if (module is not null)
        {
            try { await module.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
    }
}
